##############################################################################
# KToolBox reads `.env`, then `prod.env`, from the current working directory. #
# All values are optional. Run `ktoolbox config example` for every key.        #
##############################################################################

# Pawchive defaults. Overrides are normally unnecessary.
#KTOOLBOX_API__SCHEME=https
#KTOOLBOX_API__NETLOC=pawchive.pw
#KTOOLBOX_API__STATICS_NETLOC=pawchive.pw
#KTOOLBOX_API__PATH=/api/v1
#KTOOLBOX_DOWNLOADER__FILES_NETLOC=file.pawchive.pw
#KTOOLBOX_DOWNLOADER__FILE_PATH_PREFIX=/data

# Publication timestamps without an offset are interpreted by Pawchive Service,
# then converted to the project's display and naming timezone. New projects
# write the detected host IANA timezone to TARGET_TIMEZONE once during creation.
#KTOOLBOX_PUBLISHED_TIME__TARGET_TIMEZONE=Asia/Shanghai
#KTOOLBOX_PUBLISHED_TIME__FALLBACK_SERVICE_TIMEZONE=UTC
#KTOOLBOX_PUBLISHED_TIME__SERVICE_TIMEZONES__FANBOX=Asia/Tokyo
#KTOOLBOX_PUBLISHED_TIME__SERVICE_TIMEZONES__PATREON=UTC
#KTOOLBOX_PUBLISHED_TIME__SERVICE_TIMEZONES__CUSTOM_SERVICE=Europe/Paris

# Optional cookie sent only to file downloads. API requests never use it.
#KTOOLBOX_DOWNLOADER__SESSION_KEY=xxxxx

# Download four files concurrently.
KTOOLBOX_JOB__COUNT=4

# Prepare up to four creators concurrently during multi-creator sync.
KTOOLBOX_JOB__CREATOR_CONCURRENCY=4

# Directory and filename templates belong to the project's `[naming]` table in
# `ktoolbox.toml`. Configure them through the WebUI Naming Format page.

# Choose what to download and optionally enforce byte-size limits.
#KTOOLBOX_JOB__DOWNLOAD_FILE=True
#KTOOLBOX_JOB__DOWNLOAD_ATTACHMENTS=True
#KTOOLBOX_JOB__MIN_FILE_SIZE=1024
#KTOOLBOX_JOB__MAX_FILE_SIZE=1048576

# Filter attachment names with Unix shell patterns.
#KTOOLBOX_JOB__ALLOW_LIST='["*.jpg", "*.png"]'
#KTOOLBOX_JOB__BLOCK_LIST='["*.zip", "*.psd"]'

# Define structured global or creator-scoped exclusions in `ktoolbox.toml`.
#KTOOLBOX_JOB__KEYWORDS_EXCLUDE='["legacy global title term"]'

# Optional HeroUI WebUI. When credentials are empty, each launch uses `admin`
# with a new random password and prints both in the terminal. Configure stable
# credentials with the preferred Argon2id hash from `ktoolbox webui
# hash-password`; quote the hash because it contains `$` characters.
#KTOOLBOX_WEBUI__HOST=0.0.0.0
#KTOOLBOX_WEBUI__PORT=8789
#KTOOLBOX_WEBUI__OPEN_BROWSER=True
#KTOOLBOX_WEBUI__USERNAME=owner
#KTOOLBOX_WEBUI__PASSWORD_HASH='$argon2id$v=19$...'
#KTOOLBOX_WEBUI__PASSWORD=plaintext-fallback
#KTOOLBOX_WEBUI__MAX_ACTIVE_TASKS=2
#KTOOLBOX_WEBUI__SESSION_IDLE_HOURS=24
#KTOOLBOX_WEBUI__SESSION_ABSOLUTE_HOURS=168
